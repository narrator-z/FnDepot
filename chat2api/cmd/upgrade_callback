#!/bin/bash
# 升级后：比对新旧版本、清理残留、提示端口变更。
# 全程 exit 0，不阻塞升级。
set -u
LOG="/tmp/chat2api_upgrade.log"
# 同 install_callback：同时输出 stdout，便于框架统一收集日志
log() { echo "[$(date '+%F %T')] $*"; echo "[$(date '+%F %T')] $*" >>"$LOG" 2>/dev/null; return 0; }

log "==== upgrade_callback 开始 ===="

# ⚠️ 不要用 [ -d "$cand/app/server" ] 做存在性校验：app.tgz 解包后没有 app/ 这一层
APP_DIR=""
for cand in "/var/apps/chat2api" "${TRIM_APPDEST:-}" "/usr/local/apps/@appcenter/chat2api"; do
    [ -n "$cand" ] && [ -d "$cand" ] && { APP_DIR="$cand"; break; }
done
[ -z "$APP_DIR" ] && APP_DIR="${TRIM_APPDEST:-/var/apps/chat2api}"

RUNTIME_DIR="$APP_DIR/target"
[ -d "$RUNTIME_DIR" ] || RUNTIME_DIR="$APP_DIR"

mkdir -p "$RUNTIME_DIR/logs" 2>/dev/null
# 两个位置都清：target 软链存在时它们不同，残留的旧 socket 会让新版启动时 EADDRINUSE
rm -f "$RUNTIME_DIR/app.sock" "$APP_DIR/app.sock" "$RUNTIME_DIR/chat2api.pid" 2>/dev/null

# 从旧版（1.3.4 及更早，nx5888 版）升级的端口变更提示：
# 旧版管理界面占 8081、API 占 8080，均属飞牛第三方应用拥挤端口段；
# 新版管理界面走统一网关不占端口，API 改到 26800。
log "端口策略：管理界面=统一网关 /app/chat2api（不占端口）；API 代理=${TRIM_SERVICE_PORT:-26800}"
log "若外部客户端（Cline / Cherry Studio 等）原来填的是 8080，请改为 26800。"

export PATH="/var/apps/nodejs_v22/target/bin:$PATH"
log "Node.js: $(node -v 2>/dev/null || echo '未找到')"

log "==== upgrade_callback 结束 ===="
exit 0
