#!/bin/bash
# 配置变更后：重启服务让新端口/新配置生效。
# 注意：fnOS 改完配置会自行重建运行环境，这里只负责把服务拉起来；
# 不等待就绪（避免阻塞），失败可在 /var/apps/chat2api/target/logs/server.log 排查。
set -u

MAIN="${TRIM_APPDEST:-/var/apps/chat2api}/cmd/main"
if [ -x "$MAIN" ]; then
    "$MAIN" stop >/dev/null 2>&1
    sleep 1
    "$MAIN" start >/dev/null 2>&1
fi

exit 0
