#!/bin/bash
# Chat2API fnOS 生命周期管理
# 用法: cmd/main {start|stop|restart|status}
#
# 设计要点：
#   1) Node.js 用飞牛官方运行时 nodejs_v22（manifest 里 install_dep_apps 声明），不自己装。
#   2) 管理界面监听 Unix Socket，由飞牛统一网关挂到 /app/chat2api
#      —— 不占 TCP 端口，天然无端口冲突。
#      同时监听 ${TRIM_APPDEST}/target/app.sock 与 ${TRIM_APPDEST}/app.sock：
#      官方文档要求 target/ 下，但本机已装应用（frpc/Harness/fndepot）都放应用根目录，
#      两个位置都监听以免赌错。
#   3) OpenAI API 代理监听 TCP 26800（外部客户端必须走 IP+端口，无法走需登录的网关）。
#      端口取 fnOS 注入的 TRIM_SERVICE_PORT，回退 manifest 的 service_port。
#   4) 进程由 fnOS 框架经本脚本管理，不自建 systemd。

set -u

# ---------- Node.js 运行时 ----------
NODE_BIN_DIR="/var/apps/nodejs_v22/target/bin"
export PATH="$NODE_BIN_DIR:$PATH"

# ---------- 目录定位 ----------
# TRIM_APPDEST 由 fnOS 注入（实测为 /vol3/@appcenter/chat2api），优先使用；
# 其余仅为兼容旧式安装路径的兜底。
#
# ⚠️ 不要用 [ -d "$cand/app/server" ] 之类的子目录做存在性校验。
# 飞牛安装时把 app.tgz 解包到应用根目录，内容是 server/ 与 ui/，
# 并【没有 app/ 这一层】（源码仓库里才有 app/server）。
# 早期版本正是因此把 TRIM_APPDEST 全部否掉、回退到不存在的 /var/apps/chat2api，
# 导致 server-entry.js 找不到、进程起不来、网关返回 bad gateway。
APP_DIR=""
for cand in "${TRIM_APPDEST:-}" "/var/apps/chat2api" "/usr/local/apps/@appcenter/chat2api"; do
    [ -n "$cand" ] && [ -d "$cand" ] && { APP_DIR="$cand"; break; }
done
[ -z "$APP_DIR" ] && APP_DIR="${TRIM_APPDEST:-/var/apps/chat2api}"

# 服务端根目录布局自适应：
#   安装后（app.tgz 解包）→ $APP_DIR/server
#   源码仓库            → $APP_DIR/app/server
if [ -f "$APP_DIR/server/server-entry.js" ]; then
    SERVER_ROOT="$APP_DIR/server"
else
    SERVER_ROOT="$APP_DIR/app/server"
fi

SERVER_JS="$SERVER_ROOT/server-entry.js"
RUNTIME_DIR="$APP_DIR/target"
# socket 位置：官方文档要求放 target/ 下，但本机实测 frpc / Harness / fndepot
# 等已装应用的 socket 都在应用根目录，且 frpc / Harness 压根没有 target/。
# 规范与实现存在差异，故两个位置都监听，避免赌错一边。
SOCKET_PATH="$RUNTIME_DIR/app.sock,$APP_DIR/app.sock"
PID_FILE="$RUNTIME_DIR/chat2api.pid"
LOG_DIR="$RUNTIME_DIR/logs"
LOG_FILE="$LOG_DIR/server.log"
STATIC_DIR="$SERVER_ROOT/public"

# ---------- 数据目录 ----------
if [ -n "${CHAT2API_DATA_DIR:-}" ]; then
    DATA_DIR="$CHAT2API_DATA_DIR"
elif [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}/data"
else
    DATA_DIR="$APP_DIR/data"
fi

# ---------- 端口（仅 API 代理）----------
# 优先级：安装向导字段 wizard_app_port > fnOS 注入的 TRIM_SERVICE_PORT > manifest 默认值。
#
# 为什么向导值必须排在 TRIM_SERVICE_PORT 前面：
#   官方文档明确 TRIM_SERVICE_PORT 来自 manifest.service_port，是静态值，不随向导变化。
#   若让它在前，用户在安装向导里改了端口也永远是 manifest 里的 26800，改了等于没改。
# 注意：飞牛把向导字段的值以「字段名」注入环境变量（例如 $wizard_app_port），
# 不是臆造的 CHAT2API_PORT 之类，取不到值时静默回退默认值。
API_PORT="${wizard_app_port:-}"
[ -z "$API_PORT" ] && API_PORT="${TRIM_SERVICE_PORT:-}"
[ -z "$API_PORT" ] && API_PORT="26800"
case "$API_PORT" in
    ''|*[!0-9]*) API_PORT="26800" ;;
esac

mkdir -p "$RUNTIME_DIR" "$LOG_DIR" "$DATA_DIR" 2>/dev/null

log() {
    # 同时输出 stdout（框架统一收集）与日志文件（事后排查）
    echo "[$(date '+%F %T')] $*"
    echo "[$(date '+%F %T')] $*" >>"$LOG_FILE" 2>/dev/null
    return 0
}

# SOCKET_PATH 可能是逗号分隔的多个路径，统一按列表处理
socket_list() {
    echo "$SOCKET_PATH" | tr ',' ' '
}

remove_sockets() {
    for s in $(socket_list); do
        rm -f "$s" 2>/dev/null
    done
    return 0
}

# 任意一个 socket 就绪即认为服务可用
socket_ready() {
    for s in $(socket_list); do
        [ -S "$s" ] && return 0
    done
    return 1
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

do_start() {
    if is_running; then
        log "already running (pid $(cat "$PID_FILE"))"
        return 0
    fi

    if [ ! -f "$SERVER_JS" ]; then
        log "ERROR: $SERVER_JS not found"
        return 1
    fi

    if ! command -v node >/dev/null 2>&1; then
        log "ERROR: node not found in $NODE_BIN_DIR"
        return 1
    fi

    # 清理上次残留的 socket，否则新版启动会 EADDRINUSE
    # 注意 SOCKET_PATH 是逗号分隔的多路径，必须逐个删，rm -f "$SOCKET_PATH" 会把整串
    # 当成一个文件名（含逗号），实际一个都删不掉。
    remove_sockets

    export NODE_ENV=production
    export API_PORT
    export SOCKET_PATH
    export DATA_DIR
    export STATIC_DIR
    export CHAT2API_DATA_DIR="$DATA_DIR"

    cd "$SERVER_ROOT" || { log "ERROR: cannot cd $SERVER_ROOT"; return 1; }

    # setsid 脱离进程组，避免被 fnOS 的进程组清理误杀；无 setsid 时退回 nohup
    if command -v setsid >/dev/null 2>&1; then
        setsid node "$SERVER_JS" >>"$LOG_FILE" 2>&1 </dev/null &
    else
        nohup node "$SERVER_JS" >>"$LOG_FILE" 2>&1 </dev/null &
    fi
    echo $! >"$PID_FILE"
    log "started pid=$(cat "$PID_FILE") api_port=$API_PORT socket=$SOCKET_PATH"

    # 等 socket 就绪，最长 20 秒
    i=0
    while [ "$i" -lt 20 ]; do
        socket_ready && { log "socket ready"; return 0; }
        is_running || { log "ERROR: process exited during startup"; return 1; }
        i=$((i + 1))
        sleep 1
    done
    log "WARN: socket not ready after 20s (API 端口可能仍可用)"
    return 0
}

do_stop() {
    if [ ! -f "$PID_FILE" ]; then
        remove_sockets
        return 0
    fi
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null
        i=0
        while [ "$i" -lt 10 ]; do
            kill -0 "$pid" 2>/dev/null || break
            i=$((i + 1))
            sleep 1
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        log "stopped pid=$pid"
    fi
    rm -f "$PID_FILE" 2>/dev/null
    remove_sockets
    return 0
}

case "${1:-}" in
    start)
        do_start
        ;;
    stop)
        do_stop
        ;;
    restart)
        do_stop
        sleep 1
        do_start
        ;;
    status)
        # 运行中 exit 0；已停止 exit 3（fnOS 以此判断应用状态）
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

# 回调类场景一律不阻塞安装/升级
exit 0
